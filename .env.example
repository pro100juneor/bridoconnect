# ─────────────────────────────────────────────────────────────
# BridoConnect — environment template.
# Скопіюй в .env.local (dev) або .env.production (prod build).
# ─────────────────────────────────────────────────────────────

# ── Supabase (client + edge)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...      # server-side тільки
SUPABASE_DB_URL=postgresql://...

# ── App
VITE_APP_URL=https://bridoconnect.com
VITE_APP_VERSION=0.1.0

# ── Observability
VITE_SENTRY_DSN=https://xxx@sentry.io/xxx
SENTRY_ORG=luftarbeiter
SENTRY_PROJECT=bridoconnect-web
SENTRY_AUTH_TOKEN=                            # для source-maps upload

VITE_POSTHOG_KEY=phc_xxx
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# ── Email (Resend)
RESEND_API_KEY=re_xxx
EMAIL_FROM=BridoConnect <no-reply@bridoconnect.com>
EMAIL_REPLY_TO=support@bridoconnect.com

# ── Web Push (VAPID) — сгенерувати `npx web-push generate-vapid-keys`
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@bridoconnect.com

# ── Payments
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...
VITE_STRIPE_PRICE_MONTHLY=price_...
VITE_STRIPE_PRICE_YEARLY=price_...

PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_WEBHOOK_ID=

ADYEN_API_KEY=
ADYEN_MERCHANT_ACCOUNT=
ADYEN_HMAC_KEY=

DLOCAL_LOGIN=
DLOCAL_TRANS_KEY=
DLOCAL_SECRET_KEY=

WISE_API_TOKEN=
WISE_PROFILE_ID=

BTCPAY_URL=
BTCPAY_STORE_ID=
BTCPAY_API_KEY=

# ── KYC + Sanctions
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
COMPLYADVANTAGE_API_KEY=

# ── LiveKit (стрими)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_WS_URL=wss://...

# ── AI generation (optional — маркетинг ассети)
RUNWAYML_API_SECRET=
ELEVENLABS_API_KEY=

# ── Hostinger deploy
HOSTINGER_HOST=example.com
HOSTINGER_USER=root
DOMAIN=bridoconnect.com
ACME_EMAIL=admin@bridoconnect.com
