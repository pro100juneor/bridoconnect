# Caddy = TLS termination + HTTP/2 + auto Let's Encrypt.
# Nginx (в контейнере web) отвечает за SPA fallback, кеш и security headers.

{
	email {$ACME_EMAIL}
	admin off
	servers {
		protocols h1 h2 h3
	}
}

{$DOMAIN} {
	encode zstd gzip

	# Rate limit на whole domain (мягкая защита от dumb-scrape)
	@spa not path /assets/* /videos/* /audio/* /images/* /favicon.svg /manifest.json /healthz
	handle {
		reverse_proxy web:80 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto https
		}
	}

	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}
}

# www → apex redirect
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
